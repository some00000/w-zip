{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "w+zip",
  "version": "0.1.0",
  "identifier": "app.wzip.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "w+zip",
        "width": 880,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
