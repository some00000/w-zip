{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window can seal and open .wzip archives",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-pick-files",
    "allow-pick-save-path",
    "allow-pick-wzip",
    "allow-pick-folder",
    "allow-pack-wzip",
    "allow-unpack-wzip"
  ]
}
